# LLMWiki 的模型凭据与角色配置
#
# 把这个文件复制到机器上的 $LLM_WIKI_HOME/env（默认 ~/.llm-wiki/env），填好 key。
#   Linux/macOS: mkdir -p ~/.llm-wiki && cp docs/knowledge-v2/env.example ~/.llm-wiki/env
#   Windows:     %USERPROFILE%\.llm-wiki\env
#
# 真实文件放在仓库外面，所以不可能被 commit。这个模板本身没有任何密钥。
#
# 只有第一项是必填的。其余留空就用默认值，删掉整行也一样。

# 必填。模型供应商的 API key。
LLM_WIKI_API_KEY=

# 供应商地址。默认 DeepSeek 官方接口。
# 填本地或自建的 OpenAI 兼容端点时改这里，例如 http://127.0.0.1:11434
LLM_WIKI_BASE_URL=https://api.deepseek.com

# 所有角色共用的默认模型。
LLM_WIKI_MODEL=deepseek-flash

# 可选的角色覆盖。留空则用上面的默认模型。
# 这项留空意味着「和默认一样」，不是「不要模型」。
#
# 提取候选用哪个模型：便宜快的调这个。
LLM_WIKI_DISCOVERY_MODEL=
# 综合与身份判断用哪个：需要推理时调这个。
LLM_WIKI_REASONING_MODEL=
# grounding 与 value gate 用哪个。规格要求不要预设成廉价分类器。
LLM_WIKI_GROUNDING_MODEL=
# 只在对页面做润色时才用到。首版页面是确定性模板，不需要模型。
LLM_WIKI_RENDER_MODEL=

# 本地权威知识库的位置。改这里会同时决定 env 文件自己的位置，
# 所以填在文件里对它自己无效，要在 shell 里导出才生效。
# LLM_WIKI_HOME=~/.llm-wiki

# 本地知识空间的名字。多台机器共用一份数据库时才需要固定。
# LLM_WIKI_SPACE=local
