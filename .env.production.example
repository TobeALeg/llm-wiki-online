# Copy to .env.production on the deployment host. Never commit the filled file.
MENTI_AUTHORIZE_URL=https://menti.example.invalid/oauth/authorize
MENTI_AUTH_CODE_URL=https://menti.example.invalid/oauth/token
MENTI_MEMBERS_URL=https://menti.example.invalid/api/members
MENTI_CLIENT_ID=
MENTI_CLIENT_SECRET=
MENTI_REDIRECT_URI=https://lw.app.mentti.work/auth/callback
MENTI_WEBHOOK_SECRET=
LLM_WIKI_API_KEY=
LLM_WIKI_BASE_URL=https://api.deepseek.com
LLM_WIKI_MODEL=deepseek-flash
LLM_WIKI_RECONCILE_INTERVAL_SECONDS=900

# GitHub Actions deployment secrets are configured separately. The known-hosts
# value must contain the exact ssh-keyscan line for LW_DEPLOY_HOST.
